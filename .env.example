# Copy this file to .env and fill in your API keys.
# .env is gitignored and never committed.

# ── Vision enrichment (Asset Matcher Phase 1) ─────────────────────────────────
# Enterprise AI gateway for image description generation (chat/completions).
# Uses Gemini / Vertex AI via the gateway's /vertex/v1/ route.
VIDEO_ANALYSIS_BASE_URL=
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_MODEL=gemini-2.5-flash

# ── Semantic embedding (Asset Matcher Phase 2) ────────────────────────────────
# OpenAI-compatible /v1/embeddings endpoint.
# Falls back to VIDEO_ANALYSIS_* if not set; falls back to BM25 if neither set.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── HTML generation ───────────────────────────────────────────────────────────
HTML_GEN_BASE_URL=
HTML_GEN_API_KEY=
HTML_GEN_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0

# ── HyperFrames capture (used by npx hyperframes capture) ────────────────────
# HF reads GEMINI_API_KEY + GEMINI_BASE_URL directly for asset-descriptions.md.
GEMINI_API_KEY=
GEMINI_BASE_URL=

# ── Asset Matcher quality floor ───────────────────────────────────────────────
# Minimum match score for an asset to be offered to a frame at all.
# Defaults: 0.35 cosine (embedding path) / 0.30 (BM25 fallback).
# Below the floor a frame simply gets no candidate — better than a confident
# wrong asset, which a T2V model would faithfully reproduce.
ASSET_MIN_SCORE=

# ── Optional ──────────────────────────────────────────────────────────────────
# Figma API token (required for figma.com URL input path)
FIGMA_TOKEN=

# Pexels stock footage search (skipped if empty)
PEXELS_API_KEY=

# Scene-change detection sensitivity for capture (lower = more frames)
SCENE_THRESHOLD=0.35

# ── AI video models on the company gateway (python -m clip_weave gen-video) ───
# 豆包 / Seedance — Volcengine Ark protocol (POST /api/v3/contents/generations/tasks)
DOUBAO_VIDEO_BASE_URL=http://aigateway.t1.test.noahgrouptest.com/doubaovideo
DOUBAO_VIDEO_API_KEY=
DOUBAO_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
# Allowed clip durations for your model: "5,10" (Seedance 1.0) or "4-15" (1.5 / 2.0)
DOUBAO_VIDEO_DURATIONS=5,10
# Override only if the gateway does not preserve the upstream path:
# DOUBAO_VIDEO_TASKS_PATH=/api/v3/contents/generations/tasks

# 阿里 通义万相 — DashScope async protocol (X-DashScope-Async: enable)
ALI_VIDEO_BASE_URL=http://aigateway.t1.test.noahgrouptest.com/alivideo
ALI_VIDEO_API_KEY=
ALI_VIDEO_MODEL=wan2.5-t2v-preview
# auto | wan27 (resolution+ratio) | legacy (size). auto infers from the model name.
ALI_VIDEO_PROTOCOL=auto
# ALI_VIDEO_SUBMIT_PATH=/api/v1/services/aigc/video-generation/video-synthesis
# ALI_VIDEO_TASK_PATH=/api/v1/tasks/{task_id}

# Google Veo — Vertex AI predictLongRunning / fetchPredictOperation
VERTEX_VIDEO_BASE_URL=http://aigateway.t1.test.noahgrouptest.sg/vertexvideo
VERTEX_VIDEO_API_KEY=
VERTEX_VIDEO_MODEL=veo-3.1-generate-001
VERTEX_VIDEO_API_VERSION=v1
# Vertex requires a real GCP project id in the resource path (it is the billing
# identity, not a label — an invented name returns 403 CONSUMER_INVALID).
# Resolution order: this var → GOOGLE_CLOUD_PROJECT → BRIEF.md / storyboard
# frontmatter (vertex_project:) → `gcloud config get-value project`.
VERTEX_VIDEO_PROJECT=
VERTEX_VIDEO_LOCATION=us-central1
# Or pin the whole resource path and skip the resolution above:
# VERTEX_VIDEO_MODEL_PATH=projects/x/locations/us-central1/publishers/google/models/veo-3.1-generate-001
