# Copy this file to .env and fill in your API keys.
# .env is gitignored and never committed.

# Required for Asset Matcher embedding + HF capture asset-descriptions generation
GEMINI_API_KEY=

# Optional: alternative embedding provider (if providers.embedding = openai in config.yaml)
OPENAI_API_KEY=

# Optional: HeyGen TTS voice synthesis (required for narrated videos)
HEYGEN_API_KEY=

# Optional: Figma API token (required for Figma URL input path)
FIGMA_TOKEN=
