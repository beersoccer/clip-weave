# Copy this file to .env and fill in your API keys.
# .env is gitignored and never committed.

# ── General-purpose LLM — 通用推理（改写、路由、质量检查）────────────────────
# 所有需要文本推理的地方（T2V 场景改写、工作流路由、未来的质量检查）统一走这里。
# 推荐指向 Anthropic API（或兼容代理），与下面的视频生成 / 图像分析 key 完全隔离。
# 未配置：场景改写跳过、路由降级为关键词匹配，两者均不报错、不中断流程。
#
# 典型配置（直连 Anthropic）：
#   CLAUDE_BASE_URL=https://api.anthropic.com
#   CLAUDE_API_KEY=sk-ant-...
#   CLAUDE_MODEL=claude-sonnet-4-6    # 留空则用上面的默认值
#
# 若走公司代理（Bedrock / 自定义兼容层），把 CLAUDE_BASE_URL 换成代理地址。
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# ── Vision enrichment (Asset Matcher Phase 1) — 素材图像理解 ───────────────────
# clip-weave 自己调用：{BASE_URL}/chat/completions，OpenAI messages 格式。
# 专用于图像内容理解，不应被通用 LLM 任务复用。
# 未配置：跳过 Vision 增强，用 capture 原始描述；不影响下面的 Embedding 阶段。
VIDEO_ANALYSIS_BASE_URL=
VIDEO_ANALYSIS_API_KEY=
VIDEO_ANALYSIS_MODEL=gemini-2.5-flash

# ── Semantic embedding (Asset Matcher Phase 2) — 素材语义排序 ──────────────────
# OpenAI 兼容的 /v1/embeddings 接口。与上面的 VIDEO_ANALYSIS_* 完全独立。
# 未配置：自动降级为 BM25 关键词匹配。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ── HyperFrames capture（HF CLI 自己读取，clip-weave 的 Python 代码不消费）────
# npx hyperframes capture 用它生成 asset-descriptions.md；协议由 HF 自己实现，
# 与上面的 VIDEO_ANALYSIS_*（clip-weave 的 chat/completions 调用）互不相关，
# 即便两者当前指向同一个网关地址也不要合并成一个变量。
GEMINI_API_KEY=
GEMINI_BASE_URL=

# ── Asset Matcher quality floor ───────────────────────────────────────────────
# Minimum match score for an asset to be offered to a frame at all.
# Defaults: 0.35 cosine (embedding path) / 0.30 (BM25 fallback).
# Below the floor a frame simply gets no candidate — better than a confident
# wrong asset, which a T2V model would faithfully reproduce.
ASSET_MIN_SCORE=

# ── Optional ──────────────────────────────────────────────────────────────────
# Figma API token (required for figma.com URL input path)
FIGMA_TOKEN=

# Pexels stock footage search (skipped if empty)
PEXELS_API_KEY=

# Scene-change detection sensitivity for capture (lower = more frames)
SCENE_THRESHOLD=0.35

# ── AI video models on the company gateway (python -m clip_weave gen-video) ──
# 三个 provider 各自一组 *_BASE_URL / *_API_KEY / *_MODEL，完全独立、互不影响。
# *_API_KEY 每家都可以单独填；如果不填，会回退到下面这个共享的网关 key——网关
# 给三条视频路由（包括 Vertex）发的是同一把 key，配 AI_GATEWAY_API_KEY 一次即可
# 让三家都工作，不用三份 .env 各抄一遍。某家需要不同的 key 时，填它自己的
# *_API_KEY（优先于共享 key）。*_BASE_URL / *_MODEL 留空则使用代码内置默认值
# （已在 docs/ai-video-models.md 用这些默认值实测过）。

# 三条路由共用的网关 key；未单独配置某家的 *_API_KEY 时用它。
AI_GATEWAY_API_KEY=

# 豆包 / Seedance — Volcengine Ark protocol (POST /api/v3/contents/generations/tasks)
DOUBAO_VIDEO_BASE_URL=http://aigateway.t1.test.noahgrouptest.com/doubaovideo
DOUBAO_VIDEO_API_KEY=
# Seedance 2.0 — current flagship, confirmed available on the gateway
# (2026-08-03: `scripts/verify_video_gateway.py --models --provider doubao`).
# 1.0-pro is the prior generation; 1.5-pro is not provisioned on this gateway
# (404 InvalidEndpointOrModel as of the same check).
DOUBAO_VIDEO_MODEL=doubao-seedance-2-0-260128
# Allowed clip durations for your model: "4-15" (2.0 / 1.5) or "5,10" (1.0-pro)
DOUBAO_VIDEO_DURATIONS=4-15
# Override only if the gateway does not preserve the upstream path:
# DOUBAO_VIDEO_TASKS_PATH=/api/v3/contents/generations/tasks

# 阿里 通义万相 — DashScope async protocol (X-DashScope-Async: enable)
ALI_VIDEO_BASE_URL=http://aigateway.t1.test.noahgrouptest.com/alivideo
ALI_VIDEO_API_KEY=
# wan2.7-t2v — current flagship, confirmed available on the gateway
# (2026-08-03: `scripts/verify_video_gateway.py --models --provider ali`).
# wan2.5-t2v-preview is a superseded preview build.
ALI_VIDEO_MODEL=wan2.7-t2v
# auto | wan27 (resolution+ratio) | legacy (size). auto infers from the model name.
ALI_VIDEO_PROTOCOL=auto
# ALI_VIDEO_SUBMIT_PATH=/api/v1/services/aigc/video-generation/video-synthesis
# ALI_VIDEO_TASK_PATH=/api/v1/tasks/{task_id}

# Google Veo — Vertex AI predictLongRunning / fetchPredictOperation, proxied
# through the gateway. The upstream resource path is the real Vertex AI form
# and always needs a project id in it — the gateway does not offer a
# project-less shortcut:
#   {VERTEX_VIDEO_BASE_URL}/v1/projects/{PROJECT}/locations/{LOCATION}
#     /publishers/google/models/{MODEL}:predictLongRunning
# Still authenticated with the gateway's own Bearer key (VERTEX_VIDEO_API_KEY /
# AI_GATEWAY_API_KEY) — NOT a Google OAuth2 token. Calling the real Google host
# (*.aiplatform.googleapis.com) directly with this key fails with
# 401 ACCESS_TOKEN_TYPE_UNSUPPORTED; it only works proxied through the gateway.
VERTEX_VIDEO_BASE_URL=http://aigateway.t1.test.noahgrouptest.sg/vertexvideo
VERTEX_VIDEO_API_KEY=
VERTEX_VIDEO_MODEL=veo-3.1-generate-001
VERTEX_VIDEO_API_VERSION=v1
# Required — the resource path has no meaning without it. It is a real GCP
# project id (the billing identity), not a label — an invented name returns
# 403 CONSUMER_INVALID. Resolution order: this var → GOOGLE_CLOUD_PROJECT →
# BRIEF.md / storyboard frontmatter (vertex_project:) →
# `gcloud config get-value project`.
VERTEX_VIDEO_PROJECT=
VERTEX_VIDEO_LOCATION=us-central1
# Or pin the whole resource path and skip project/location entirely:
# VERTEX_VIDEO_MODEL_PATH=projects/x/locations/us-central1/publishers/google/models/veo-3.1-generate-001
